# Doxygen configuration for find's public C++ API.
PROJECT_NAME           = "find"
PROJECT_BRIEF          = "Lower-bound search over sorted newline-delimited files"
OUTPUT_DIRECTORY       = ../build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = NO

INPUT                  = ../src
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE                = ../src/main.cpp

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
QUIET                  = NO
